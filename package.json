{
  "name": "carnet",
  "version": "0.11.0",
  "private": true,
  "description": "Mobile-first knowledge capture for Obsidian, with LLM enrichment via OmniRoute and sync via Syncthing",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm -w @carnet/shared run build",
    "mobile": "npm -w @carnet/mobile start",
    "mdcrm:build": "npm -w @carnet/mdcrm run build",
    "mdcrm:test": "npm -w @carnet/mdcrm test",
    "mdcrm": "npm -w @carnet/mdcrm start --",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "metro-runtime": "0.83.3",
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "react-native-worklets": "0.5.1"
  }
}
